# Server Configuration
PORT=3000
NODE_ENV=development
# Log level: fatal|error|warn|info|debug|trace. Use warn or error in production.
LOG_LEVEL=info

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI Configuration (optional at startup; required when AI features are used)
OPENAI_API_KEY=your_openai_api_key
# Groq — English STT (whisper-large-v3-turbo). Unset → enqueue falls back to OpenAI Whisper.
# GROQ_API_KEY=
# Model for DM replies + leftover getOpenAIConfig() callers; default: gpt-5.6-luna
OPENAI_MODEL=gpt-5.6-luna
# Max tokens for completion (cost control); default: 256
OPENAI_MAX_TOKENS=256
# lat-02: DM intent / booking-turn classification (bounded JSON); default: gpt-4o-mini — never flagship
# OPENAI_INTENT_CLASSIFY_MODEL=gpt-4o-mini
# OPENAI_INTENT_CLASSIFY_MAX_TOKENS=160
# subj-14: complaint free-text parse — Tier 1 (auto-gated fallback); default: gpt-4o-mini
# OPENAI_COMPLAINT_PARSE_MODEL=gpt-4o-mini
# subj-14: complaint parse — Tier 2 (explicit refine / Tier-1 retry); default: OPENAI_MODEL
# OPENAI_COMPLAINT_PARSE_ESCALATION_MODEL=gpt-5.6-luna
# subj-14: max completion tokens for complaint parse JSON; default: 500
# OPENAI_COMPLAINT_PARSE_MAX_TOKENS=500
# chart med free-text parse — Tier 1 (auto-gated fallback); default: gpt-4o-mini
# OPENAI_MEDICINE_PARSE_MODEL=gpt-4o-mini
# chart med parse — Tier 2 (explicit refine / Tier-1 retry); default: OPENAI_MODEL
# OPENAI_MEDICINE_PARSE_ESCALATION_MODEL=gpt-5.6-luna
# chart med parse — max completion tokens for multi-drug JSON; default: 700
# OPENAI_MEDICINE_PARSE_MAX_TOKENS=700

# rpt-05.6: lab-report PHOTO extraction (vision).
#
# READ BEFORE ENABLING. Every other AI feature above sends PHI-redacted TEXT.
# This one sends the report image itself, and a lab report has the patient's
# name, age, and UHID printed on it — so it cannot be redacted. Turning this on
# makes the model provider a processor of identifiable PHI. Leave it off until
# that decision is recorded (zero-retention terms + patient consent language).
# Off = photo extraction returns "not enabled" and the doctor types results in
# manually; no image leaves the server.
# OPENAI_LAB_VISION_ENABLED=false
# rpt-05.6: vision model. Must accept image input; NOT a mini tier (dense lab
# tables are where mini misreads). default: gpt-4o
# OPENAI_LAB_VISION_MODEL=gpt-4o
# rpt-05.6: max completion tokens; a full panel photo can run ~60 rows. default: 4000
# OPENAI_LAB_VISION_MAX_TOKENS=4000

# Post–medical-deflection payment-existence DM ack: when unset or not "false"/"0", canonical English is localized via OpenAI using the user's language. Set to false for English-only or tests.
# POST_MEDICAL_ACK_AI_LOCALIZE=false

# Reason-first “noted reasons” / confirm snippet: **leave unset in production** (→ OpenAI JSON extraction in
# resolveVisitReasonSnippetForTriage). Deterministic distillation is only a safety fallback; do not rely on it
# for new patient phrasings (see docs/Reference/product/receptionist-bot/AI_BOT_BUILDING_PHILOSOPHY.md). Set false for local/tests only.
# VISIT_REASON_SNIPPET_AI_ENABLED=false

# Clinical-led fee DM: before deferring ambiguous catalog rows to staff, try allowlist LLM match once (multi-row teleconsult catalog).
# FEE_DM_CATALOG_LLM_NARROW_ENABLED=false

# book_for_someone_else: when regex kin match is missing or generic, one OpenAI JSON call for relation label (e.g. grandmother, friend).
# BOOKING_RELATION_LLM_ENABLED=false

# Staff feedback learning (learn-02): persist service_match_learning_examples on staff confirm/reassign. Set false to disable ingest.
# SERVICE_MATCH_LEARNING_INGEST_ENABLED=false

# Staff feedback shadow (learn-03): hypothetical suggestion when a pending staff review row is created. Set false to disable.
# SHADOW_LEARNING_ENABLED=false

# learn-04: policy suggestion thresholds (stable reassignment RPC); optional email when a new suggestion row is inserted.
# LEARNING_POLICY_MIN_RESOLUTIONS=5
# LEARNING_POLICY_WINDOW_DAYS=30
# LEARNING_POLICY_SNOOZE_DAYS=14
# LEARNING_POLICY_SUGGESTION_EMAIL_ENABLED=false

# learn-05: apply saved autobook policies when structured pattern matches (skip staff review). Kill switch:
# LEARNING_AUTOBOOK_ENABLED=false

# Plan 03 · Task 11 Phase 1 — emit one-shot structured warnings at every classified legacy
# `appointment_fee_minor` call site. Default OFF (production quiet). Flip to `true` in dev/staging.
# See docs/Work/Architecture/legacy-appointment-fee-minor-deprecation.md
# DEPRECATION_WARNINGS_ENABLED=true


# Webhook URL (for local development, use ngrok)
WEBHOOK_URL=http://localhost:3000

# Redis / Webhook Queue (optional - leave unset to use placeholder queue)
REDIS_URL=redis://localhost:6379
WEBHOOK_WORKER_CONCURRENCY=5

# Encryption (required when using webhooks and dead letter queue - payloads are encrypted at rest)
# Base64-encoded 32-byte key (256 bits for AES-256). Generate e.g. with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Multi-doctor: each doctor connects Instagram via dashboard (Settings); webhook uses page_id → doctor_id resolution. Not used in production.
# DEFAULT_DOCTOR_ID=  (deprecated; do not use)
# Default doctor country for payment routing: IN=India (Razorpay), US/UK/EU=PayPal
# Used when doctor has no row in doctor_settings (e-task-4.1)
DEFAULT_DOCTOR_COUNTRY=IN
# Appointment fee fallback when doctor has no settings (optional). Doctors should set fee in Dashboard > Booking Rules.
# Leave unset or 0; patients won't get payment links until doctor configures fee.
# APPOINTMENT_FEE_MINOR=50000
APPOINTMENT_FEE_CURRENCY=INR

# Notifications (e-task-5): email via Resend; doctor email fallback when not in auth
RESEND_API_KEY=
DEFAULT_DOCTOR_EMAIL=

# Web Push (task-text-D6a): VAPID keypair for PWA background notifications.
# Generate: npx web-push generate-vapid-keys
# Public key is also exposed to the browser via NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY (frontend/.env.example).
# See docs/Reference/engineering/operations/web-push/web-push-vapid-provisioning.md for rotation policy.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:ops@clariva.health

# Payment Gateways (e-task-4)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# billing P1.0 — default false. Prepaid links still hit the platform Razorpay
# account (no doctor payout after P0). Leave unset/false until P2 per-doctor
# credentials exist. Do not set true in production before that.
# DEPRECATED — prepaid is per-doctor (Settings → Payments). Do not set true.
# PREPAID_BOOKINGS_ENABLED=false
# HALO_AID_GSTIN=
# HALO_AID_LEGAL_NAME=Halo Aid
# Razorpay Route (payout): uses same keys. Enable Route in Razorpay Dashboard; add Linked Accounts for doctors.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# Booking slot picker (e-task-3 - external page; token auth)
# Secret for signing booking tokens (min 16 chars). Generate: openssl rand -base64 24
BOOKING_TOKEN_SECRET=NzIN6YyQvFspI7K+hfR9TDEoqpWWPjDF
# URL of slot picker page (e.g. https://app.example.com/book)
BOOKING_PAGE_URL=https://clariva-bot.vercel.app/book

# Instagram Configuration (Instagram API with Instagram Login — ilr-18 / e-task-13)
# Use the **Instagram app** credentials (App Dashboard → Instagram → API setup with Instagram login),
# NOT the Facebook Login / Page-linked app. Doctor connects with Instagram credentials (Business/Creator).
# Add callback URL under: Instagram → Business login settings → Valid OAuth Redirect URIs.
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
# Optional when doctors connect via OAuth (e-task-14). Used as fallback e.g. for reply to unknown page when no doctor linked.
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_min_32_chars
# INSTAGRAM_PAGE_ID= (deprecated; multi-doctor uses doctor_instagram table; each doctor connects via dashboard)
# OAuth connect flow: full callback URL (e.g. https://your-api.com/api/v1/settings/instagram/callback)
INSTAGRAM_REDIRECT_URI=https://your-api.com/api/v1/settings/instagram/callback
# After successful connect, redirect browser here (optional; if unset, callback returns JSON)
# Public bridge (not /dashboard/*) so Lax cookies survive the Meta OAuth return.
INSTAGRAM_FRONTEND_REDIRECT_URI=https://your-app.com/auth/instagram-return

# Facebook Page / Messenger (facebook-messenger-channel · fbm-01+)
# Use the **Facebook** Meta app (e.g. Halo Aid), NOT Halo Aid-IG Instagram Login credentials.
# Products: Facebook Login + Messenger + Page webhooks. Redirect under Facebook Login → Settings.
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://your-api.com/api/v1/settings/facebook/callback
FACEBOOK_FRONTEND_REDIRECT_URI=https://your-app.com/auth/facebook-return
# Optional; if omitted, Page webhook verify can reuse INSTAGRAM_WEBHOOK_VERIFY_TOKEN (same Funnel URL).
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=your_page_webhook_verify_token_min_32_chars

# Meta subscribe script (npm run meta:subscribe) - for comment webhooks when dashboard isn't enough
# Do NOT commit real values. Get from Meta Dashboard → Instagram settings → Page table + Generate token
# META_PAGE_ID=your_facebook_page_id
# META_PAGE_ACCESS_TOKEN=your_page_access_token

# Video-replay OTP via WhatsApp authentication template (Meta Cloud API, not Twilio).
# All three required to leave Twilio SMS. Template must be category AUTHENTICATION.
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_OTP_TEMPLATE_NAME=
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=en

# Twilio (SMS, Video teleconsultation)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Video access tokens: create API Key in Twilio Console (US1 region required for Video)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Media server region for Video rooms (call latency). Twilio's account default
# is us1 (Virginia); we default to in1 (Mumbai) for India-based consults.
# Valid: gll, au1, br1, de1, ie1, in1, jp1, sg1, us1, us2
# TWILIO_VIDEO_MEDIA_REGION=in1

# Cost-cut step 7. Default off. Turn on locally first, hook still enabled.
# VOICE_TRANSCRIPTION_USE_RAW_TRACKS=true
# Sitting 2 — only after raw-track STT is proven. Hook still enabled.
# RECORDING_COMPOSE_ON_DEMAND=true

# Teleconsultation (e-task-3 - patient join link)
# Secret for signing patient join tokens (min 16 chars). Generate: openssl rand -base64 24
CONSULTATION_TOKEN_SECRET=
# Base URL for the **video** legacy patient join page (`?token=` HMAC shape).
# Text + voice patient links use `APP_BASE_URL` in env.ts when set; if you
# only configure one public URL for the Next.js app, set **both** this and
# `APP_BASE_URL` to that origin (e.g. https://clariva-bot.vercel.app) so
# `sendConsultationReadyToPatient` can build `/c/text/...` and `/c/voice/...`.
CONSULTATION_JOIN_BASE_URL=
# Next.js app origin (text/voice deep links, DM join URLs). Prefer same value
# as CONSULTATION_JOIN_BASE_URL when both point at the same deployment.
# APP_BASE_URL=https://your-app.vercel.app

# First check-in DM lead (minutes before appointment). Default 30.
# Same cron also sends T−24h reminder (no link), T−15 / T−5 nudges, and T=0
# starting-now (with link; skipped when patient is already Waiting).
# Lobby only — no Twilio rooms.
# Distinct from CONSULTATION_PRE_PING_LEAD_MINUTES (text session create).
# CONSULTATION_CHECKIN_LEAD_MINUTES=30

# In-process previsit notify worker (calls consultation-checkin job on a timer).
# Unset → on in production only. Set true locally so emails fire while building
# without curling POST /cron/consultation-checkin. Safe with Render Cron too
# (stage stamps are claim-first / at-most-once).
# PREVISIT_NOTIFY_WORKER_ENABLED=true
# Tick interval ms (default 60000). Use 10000 locally for faster iteration.
# PREVISIT_NOTIFY_WORKER_INTERVAL_MS=10000

# Supabase project JWT secret (HS256 shared secret).
# From Supabase Dashboard → Project Settings → API → "JWT Secret". Min 16 chars.
# Used by two paths:
#   1. Auth performance (np-02): the auth middleware verifies the doctor's
#      access token LOCALLY with this secret instead of calling getUser on
#      every request. If unset, auth still works via a remote fallback — it
#      just loses the latency win. Effectively required in production.
#   2. Text consults (Plan 04): without it, /start-text runs fine for the
#      doctor but `sendConsultationReadyToPatient` (and `/resend-link`) cannot
#      mint the scoped patient JWT, so the IG DM / email / SMS with the
#      `/c/text/...?t=...` join link is silently skipped (logs:
#      "Consultation-ready fan-out skipped (join-token mint failed)").
# SUPABASE_JWT_SECRET=

# Teleconsultation (e-task-4 - Twilio status callbacks)
# Backend base URL for Twilio to call (e.g. https://your-api.onrender.com)
WEBHOOK_BASE_URL=
# Min consultation duration (seconds) to mark verified; default 60
# MIN_VERIFIED_CONSULTATION_SECONDS=60

# DEPRECATED billing P0 — unused. Do not set. Halo Aid never takes a cut of
# the patient's payment. Keys kept so old env files still parse.
# PLATFORM_FEE_PERCENT=0
# PLATFORM_FEE_FLAT_MINOR=0
# PLATFORM_FEE_THRESHOLD_MINOR=0
# PLATFORM_FEE_GST_PERCENT=0

# Cron secret (still used by other cron jobs). Payout cron is a no-op as of P0.
# Render cron: curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://api/cron/payouts
# Same secret gates GET /api/v1/admin/archival-preview (do not put it in a browser).
# CRON_SECRET=

# Recording archival hard-delete (rec-33). Default false. Do not set true until
# the activation runbook preconditions are recorded as met.
# docs/Reference/engineering/operations/setup/recording-archival-activation-runbook.md
# ARCHIVAL_HARD_DELETE_ENABLED=false
# ARCHIVAL_DRY_RUN_REPORT_DAYS=7

# rcp-20/24: Returning-patient memory (welcome-back, skip re-collection, follow-up offer).
# Default off in production until staged rollout. Dev: true after rcp-24 gates pass.
# Revert: set false → byte-identical to pre-Phase-5 behavior.
# RETURNING_PATIENT_MEMORY_ENABLED=true