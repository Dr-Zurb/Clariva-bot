{
  "name": "Halo Aid",
  "short_name": "Halo Aid",
  "description": "Turn your audience into your practice.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "/icon-halo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/c/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "application/pdf"] }]
    }
  },
  "shortcuts": [
    {
      "name": "New idea",
      "short_name": "New idea",
      "description": "Save a thought for later",
      "url": "/c/idea",
      "icons": [{ "src": "/icon-halo.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
