// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MessageBubble snapshots > renders a doctor text message 1`] = `
<div>
  <ul>
    <li
      class="group/message relative flex flex-col items-end"
      data-message-id="msg-001"
      role="listitem"
    >
      <div
        class="max-w-[80%] relative flex w-full justify-end self-end"
      >
        <div
          class="message-body w-max max-w-full whitespace-pre-wrap break-words px-2.5 pb-1 pt-1.5 text-[14.5px] leading-[1.35] shadow-sm rounded-2xl rounded-tr-md border border-blue-200 bg-blue-50 text-slate-900"
        >
          <span>
            Plan discussed — follow up in two weeks.
          </span>
          <span
            class="inline-flex items-center gap-0.5 float-right ml-2 mt-1 text-gray-500"
            data-testid="message-bubble-meta"
          >
            <time
              class="text-[11px] leading-none tabular-nums"
            >
              15:45
            </time>
            <span
              class="inline-flex"
              data-testid="message-delivery-ticks"
            >
              <span
                aria-label="Delivered"
                class="inline-flex shrink-0 text-gray-400"
                data-delivery="delivered"
              >
                <svg
                  aria-hidden="true"
                  class="lucide lucide-check-check h-3.5 w-3.5"
                  fill="none"
                  height="24"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                  width="24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M18 6 7 17l-5-5"
                  />
                  <path
                    d="m22 10-7.5 7.5L13 16"
                  />
                </svg>
              </span>
            </span>
          </span>
        </div>
      </div>
    </li>
  </ul>
</div>
`;

exports[`MessageBubble snapshots > renders a failed-send bubble 1`] = `
<div>
  <ul>
    <li
      class="group/message relative flex flex-col items-end border-l-2 border-red-300 pl-2"
      data-failed="true"
      data-message-id="msg-failed"
      role="listitem"
    >
      <div
        class="max-w-[80%] relative flex w-full justify-end self-end"
      >
        <div
          class="message-body w-max max-w-full whitespace-pre-wrap break-words px-2.5 pb-1 pt-1.5 text-[14.5px] leading-[1.35] shadow-sm rounded-2xl rounded-tr-md border border-blue-200 bg-blue-50 text-slate-900"
        >
          <span>
            Message that failed to send.
          </span>
          <span
            class="inline-flex items-center gap-0.5 float-right ml-2 mt-1 text-gray-500"
            data-testid="message-bubble-meta"
          >
            <time
              class="text-[11px] leading-none tabular-nums"
            >
              15:45
            </time>
          </span>
        </div>
      </div>
      <div
        class="mt-1 flex items-center gap-2 text-xs text-red-700"
        data-failure-reason="unknown"
      >
        <span>
          Failed to send
        </span>
        <button
          class="underline hover:text-red-900 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-1"
          type="button"
        >
          Retry
        </button>
        <button
          class="underline hover:text-red-900 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-1"
          type="button"
        >
          Discard
        </button>
      </div>
    </li>
  </ul>
</div>
`;

