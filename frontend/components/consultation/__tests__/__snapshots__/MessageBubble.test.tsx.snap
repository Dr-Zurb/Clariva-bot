        >
          <button
            aria-label="Jump to message from Doctor"
            class="mb-1.5 w-full min-w-0 rounded border-l-2 pl-2 pr-1 py-1 text-left text-xs border-blue-400 bg-white/70 text-gray-700 hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-1"
            type="button"
          >
            <div
              class="truncate font-medium"
            >
